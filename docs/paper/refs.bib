@misc{dagent,
  title        = {dagent — no unique primary repository for mid-run create\_agent / spawn (PARTIAL)},
  howpublished = {\url{https://github.com/search?q=dagent&type=repositories}},
  note         = {Retrieved 2026-08-26. GitHub search total=143; no repo substantiates the landscape claim ``agents spawning sub-agents''. Closest candidate RobotSe7en/dagent (6 stars) does runtime registration + delegation (runner.add\_agent + ToolAgent(agents=[...]), examples/agent\_delegation.py) — registered-subagent delegation, NOT runtime spawn. Other candidates: mz0in/DAGent (1 star, static DecisionNode/FunctionNode DAG), qpiai/dagent (9 stars, static multi-agent DAG orchestration), svdh2/dagent (1 star, deterministic DSL, early dev; README grep: no spawn/sub-agent hits), d-agent/dagent-api (0 stars, routing platform). block/go-dagent = 404. Tab.1 Q1 downgraded to PARTIAL; drop the differential claim.},
  year         = {2026}
}

