{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Angelus",
  "version": "0.5.0-preview",
  "identifier": "com.lunaticlegacy.angelus",
  "build": {
    "beforeBuildCommand": "npm run build:backend",
    "frontendDist": "../frontend/templates"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; style-src 'self' 'unsafe-inline' /plugins/; script-src 'self' 'unsafe-inline' /plugins/"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "wix": {
        "version": "0.5.0.0"
      }
    },
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": ["binaries"]
  }
}
